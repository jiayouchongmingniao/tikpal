{
  "name": "tikpal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start:api": "node server/index.mjs",
    "start:web": "node server/web.mjs",
    "media:loop": "node scripts/make-seamless-loop.mjs",
    "scene:clear": "node scripts/clear-scene-videos.mjs",
    "ota:package:mp4": "node scripts/generate-mp4-resource-otas.mjs",
    "ota:resources": "node scripts/apply-resource-ota.mjs",
    "typecheck": "tsc -b",
    "test:library": "node scripts/library-taxonomy-smoke.mjs",
    "test:airplay-state": "sh scripts/airplay-state-smoke.sh",
    "test:upnp-recognition": "bash scripts/upnp-recognition-smoke.sh",
    "test:api": "node scripts/api-smoke.mjs",
    "test:radio-logo-pack": "node scripts/radio-logo-pack-check.mjs",
    "test:ota:package:mp4": "node scripts/generate-mp4-resource-otas-smoke.mjs",
    "test:ota:resources": "node scripts/resource-ota-smoke.mjs",
    "test:kiosk": "bash scripts/radio-presets-ensure-smoke.sh && bash scripts/mpd-httpd-smoke.sh && node scripts/provider-audio-gate-fixture.mjs && bash scripts/explore-entry-fast-path-fixture.sh && node scripts/deezer-preview-recovery-fixture.mjs && node scripts/kiosk-audio-release-fixture.mjs && node scripts/apple-external-app-guard-fixture.mjs && node scripts/kiosk-package-smoke.mjs && node scripts/explore-open-lifecycle-smoke.mjs",
    "test:provider-audio-gate": "node scripts/provider-audio-gate-fixture.mjs",
    "test:cdp-manager": "node scripts/tikpal-cdp-session-manager-smoke.mjs",
    "test:initial-entry": "bash scripts/tikpal-initial-entry-fixture.sh",
    "test:explore-panel": "node scripts/explore-panel-fixture.mjs && bash scripts/explore-panel-x11-fixture.sh && node scripts/explore-panel-browser-fixture.mjs",
    "test:explore-lifecycle": "node scripts/explore-open-lifecycle-smoke.mjs",
    "test:interaction": "node scripts/interaction-smoke.mjs"
