[Unit]
Description=Tikpal Explore persistent CDP session manager
After=network.target
Wants=network.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=-@APP_DIR@/.env.kiosk
Environment=TIKPAL_WEB_MODE_CDP_SESSION_MANAGER_SOCKET=/run/tikpal/cdp-session-manager.sock
RuntimeDirectory=tikpal
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
ExecStart=/usr/bin/node --experimental-websocket @APP_DIR@/deploy/chromium/tikpal-web-mode-cdp-manager.mjs
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
