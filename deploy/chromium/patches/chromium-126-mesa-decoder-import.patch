--- a/ui/gfx/linux/gbm_wrapper.cc
+++ b/ui/gfx/linux/gbm_wrapper.cc
@@ -55,6 +55,15 @@
 #if defined(MINIGBM)
   return base::ScopedFD(gbm_bo_get_plane_fd(bo, plane));
 #else
+  // Mesa may allocate on a render device different from the display device.
+  // Let GBM export its own handle using the correct device.
+  using GetFdForPlane = int (*)(struct gbm_bo*, int);
+  static const auto get_fd_for_plane = reinterpret_cast<GetFdForPlane>(
+      dlsym(RTLD_DEFAULT, "gbm_bo_get_fd_for_plane"));
+  if (get_fd_for_plane) {
+    return base::ScopedFD(get_fd_for_plane(bo, plane));
+  }
+
   const int plane_count = GetPlaneCount(bo);
   DCHECK(plane_count > 0 && plane < static_cast<size_t>(plane_count));
 
--- a/gpu/command_buffer/service/shared_image/ozone_image_backing_factory.cc
