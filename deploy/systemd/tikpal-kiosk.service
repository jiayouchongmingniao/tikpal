[Unit]
Description=Tikpal Chromium kiosk
After=network.target tikpal-api.service tikpal-web.service
Wants=network.target tikpal-api.service tikpal-web.service

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=-@APP_DIR@/.env.kiosk
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/startx @APP_DIR@/deploy/chromium/start-tikpal-kiosk-session.sh -- :0 -br -nocursor
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
