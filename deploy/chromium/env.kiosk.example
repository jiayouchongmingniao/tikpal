# Copy to <app dir>/.env.kiosk on the Raspberry Pi and adjust only what differs.

TIKPAL_KIOSK_URL=http://localhost:4173/
TIKPAL_KIOSK_WINDOW=2560x720
TIKPAL_KIOSK_WINDOW_POSITION=0,0
TIKPAL_KIOSK_DISPLAY=:0
TIKPAL_KIOSK_DISPLAY_MODE=auto
TIKPAL_KIOSK_LOCAL_SCREEN=auto
TIKPAL_KIOSK_XRANDR_MODE=2560x720
TIKPAL_KIOSK_XRANDR_OUTPUT=auto
TIKPAL_KIOSK_XRANDR_RATE=
# Auto selection uses an explicit preference only when one is supplied, then
# any directly attached HDMI/DP output, then any non-EVDI output, and finally
# the first connected output. TURZX/EVDI USB displays expose DVI-I-* style
# RandR outputs and can consume a lot of CPU at 60 Hz over USB 2.0. Keep
# direct outputs at their native refresh, but prefer half-rate for USB/EVDI.
TIKPAL_KIOSK_XRANDR_USB_RATE=29.95
TIKPAL_KIOSK_XRANDR_USB_OUTPUT_PATTERN="^(DVI-I|DVI-D)-[0-9]+-[0-9]+$"
TIKPAL_KIOSK_XRANDR_DIRECT_OUTPUT_PATTERN="^(HDMI|DP|DisplayPort)-"
TIKPAL_KIOSK_XRANDR_CLONE_OUTPUTS=
TIKPAL_KIOSK_XRANDR_PRIMARY_PREFERRED_OUTPUTS=
TIKPAL_KIOSK_XRANDR_FALLBACK_TO_CONNECTED=1
TIKPAL_DISPLAY_MIRROR_ENABLED=0
TIKPAL_DISPLAY_MIRROR_OUTPUT=auto
TIKPAL_DISPLAY_PRIMARY_OUTPUT=
TIKPAL_DISPLAY_MODE=
TIKPAL_KIOSK_X_COMMAND_TIMEOUT_SECONDS=5
# Set to 1 only after validating the attached physical display. This runs one
# post-X, pre-Chromium soft-kick so the configured RandR rate is applied.
TIKPAL_KIOSK_APPLY_PHYSICAL_DISPLAY_MODE=0
TIKPAL_KIOSK_PHYSICAL_DISPLAY_PREPARE_COMMAND=/usr/local/sbin/tikpal-physical-display-prepare
TIKPAL_KIOSK_CPU_GOVERNOR=preserve
TIKPAL_PHYSICAL_DISPLAY_RESET_MODE=1280x720
TIKPAL_PHYSICAL_DISPLAY_SAFE_BRIGHTNESS=45
TIKPAL_PHYSICAL_DISPLAY_SAFE_CONTRAST=50
TIKPAL_PHYSICAL_DISPLAY_INPUT_SOURCE=
TIKPAL_TURZX_DEFAULT_BRIGHTNESS=45
TIKPAL_TURZX_BRIGHTNESS_COMMAND=./deploy/turzx/tikpal-turzx-brightness.sh
TIKPAL_TURZX_HIDRAW_PATH=/dev/hidraw1
TIKPAL_TURZX_HARDWARE_BRIGHTNESS_ENABLED=0
TIKPAL_TURZX_SOFT_BRIGHTNESS_MIN=0.35
TIKPAL_TURZX_X_DISPLAY=:0
TIKPAL_TURZX_XAUTHORITY=/home/moode/.Xauthority
TIKPAL_PHYSICAL_DISPLAY_DRM_CONNECTOR=auto
TIKPAL_PHYSICAL_DISPLAY_DRM_CONNECTORS=auto
TIKPAL_PHYSICAL_DISPLAY_DRM_PREFERRED_CONNECTORS=
TIKPAL_PHYSICAL_DISPLAY_DRM_FALLBACK_TO_CONNECTED=1
TIKPAL_PHYSICAL_DISPLAY_ALLOW_NO_EDID=0
TIKPAL_PHYSICAL_DISPLAY_NO_EDID_CONNECTOR_PATTERN="card[0-9]+-DVI-I-[0-9]+"
TIKPAL_PHYSICAL_DISPLAY_WAIT_READY_TIMEOUT_SECONDS=45
TIKPAL_PHYSICAL_DISPLAY_WAIT_READY_SETTLE_SECONDS=2
# Keep startup stable by default. Set a numeric schedule such as "8 25" only
# for a display that has been verified to need a post-start recovery reset.
TIKPAL_PHYSICAL_DISPLAY_DELAYED_KICK_SECONDS=none
TIKPAL_PHYSICAL_DISPLAY_DISABLE_POWER_KEYS=1
TIKPAL_PHYSICAL_DISPLAY_PCI_POWER_DEVICES=
TIKPAL_PHYSICAL_DISPLAY_PCIE_ASPM_POLICY=
TIKPAL_PHYSICAL_DISPLAY_DRM_POLL=
TIKPAL_PHYSICAL_DISPLAY_NOUVEAU_PCI_ID=
TIKPAL_PHYSICAL_DISPLAY_NOUVEAU_REBIND_SETTLE_SECONDS=3
TIKPAL_TURZX_USB_RECOVERY_ENABLED=0
TIKPAL_TURZX_USB_RECOVERY_AFTER_SECONDS=8
TIKPAL_TURZX_USB_RECOVERY_PCI_DEVICE=auto
TIKPAL_TURZX_USB_RECOVERY_REQUIRE_ERROR=1
TIKPAL_TURZX_USB_RECOVERY_SETTLE_SECONDS=8
TIKPAL_TURZX_USB_RECOVERY_MIN_INTERVAL_SECONDS=300
TIKPAL_TURZX_USB_RECOVERY_SERVICE=display_turzx.service
TIKPAL_KIOSK_RESET_WEB_MODE_ON_START=1
TIKPAL_KIOSK_VIRTUAL_DEPTH=24
# Optional override when the kiosk should read language/input defaults from a
# non-standard app state path.
TIKPAL_UI_PREFERENCES_STATE_PATH=/home/moode/code/tikpal/.tikpal/ui-preferences.json

TIKPAL_CHROMIUM_BIN=/usr/lib/chromium-browser/chromium-browser
TIKPAL_CHROMIUM_PROFILE_DIR=/home/moode/.config/tikpal-chromium-kiosk
TIKPAL_CHROMIUM_COLOR_SCHEME=dark
# Route Chromium media audio through Tikpal's audio adapter. Avoid moOde's
# Loopback-backed _audioout here; the adapter probes the current USB card and
# may use dmix or plughw depending on what that card actually accepts.
TIKPAL_CHROMIUM_ALSA_OUTPUT_DEVICE=auto
TIKPAL_KIOSK_REMOTE_DEBUG=0
TIKPAL_KIOSK_REMOTE_DEBUG_ADDRESS=0.0.0.0
TIKPAL_KIOSK_REMOTE_DEBUG_PORT=9222
TIKPAL_KIOSK_REMOTE_DEBUG_CHROMIUM_ADDRESS=127.0.0.1
TIKPAL_KIOSK_REMOTE_DEBUG_CHROMIUM_PORT=9223
# standard leaves all effects enabled; constrained limits composition work and
# automatically pauses/retries scene video when frame delivery degrades.
TIKPAL_RENDER_PROFILE=standard

TIKPAL_WEB_MODE_PROFILE_ROOT=/home/moode/.config/tikpal-web-mode
TIKPAL_WEB_MODE_SETTINGS_PATH=/home/moode/code/tikpal/.tikpal/web-mode-settings.json
TIKPAL_WEB_MODE_STATE_PATH=/home/moode/code/tikpal/.tikpal/web-mode-state.json
TIKPAL_WEB_MODE_COMMAND=./deploy/chromium/tikpal-web-mode.sh
TIKPAL_WEB_MODE_EXTENSION_DIR=/home/moode/code/tikpal/deploy/chromium/web-mode-extension
TIKPAL_WEB_MODE_EXTENSION_ENABLED=1
TIKPAL_WEB_MODE_PROXY_APPLY_TIMEOUT_SECONDS=5
TIKPAL_WEB_MODE_PROVIDER_BOOTSTRAP_TIMEOUT_SECONDS=7
TIKPAL_WEB_MODE_PROVIDER_READY_TIMEOUT_SECONDS=18
TIKPAL_WEB_MODE_PROVIDER_WINDOW_TIMEOUT_SECONDS=30
TIKPAL_WEB_MODE_DEFAULT_PROXY_URL=http://127.0.0.1:7897
TIKPAL_WEB_MODE_PROVIDER_TEXT_SCALE=1.10
TIKPAL_WEB_MODE_LEFT_WINDOW=1920x720
TIKPAL_WEB_MODE_LEFT_POSITION=0,0
TIKPAL_WEB_MODE_PANEL_WINDOW=640x720
TIKPAL_WEB_MODE_PANEL_POSITION=1920,0
TIKPAL_WEB_MODE_SIDE_PANEL_URL=http://localhost:4173/side-panel
TIKPAL_WEB_MODE_BACKGROUND_URL=http://127.0.0.1:4173/web-mode-background.html
TIKPAL_WEB_MODE_TRANSITION_URL=http://127.0.0.1:4173/web-mode-transition.html
TIKPAL_WEB_MODE_ENTRY_PROVIDER_PAINT_TIMEOUT_SECONDS=1.5
TIKPAL_WEB_MODE_ENTRY_STAGE_POSITION=0,0
TIKPAL_WEB_MODE_ENTRY_STAGE_WINDOW=2560x720
TIKPAL_WEB_MODE_ENTRY_REVEAL_SETTLE_SECONDS=0.45
TIKPAL_WEB_MODE_ENTRY_GUARD_INTERVAL_SECONDS=0.12
TIKPAL_WEB_MODE_CLOSE_WARM_ENABLED=1
TIKPAL_WEB_MODE_CLOSE_KEEP_RESIDENT=1
TIKPAL_WEB_MODE_CLOSE_WARM_TTL_SECONDS=45
TIKPAL_WEB_MODE_CLOSE_AUDIO_GATE_SETTLE_SECONDS=0.35
TIKPAL_WEB_MODE_RESIDENT_SWITCH_SETTLE_SECONDS=0.08
TIKPAL_WEB_MODE_RESIDENT_SWITCH_PAINT_TIMEOUT_SECONDS=0.6
TIKPAL_WEB_MODE_RESIDENT_SWITCH_PAINT_POLL_SECONDS=0.05
TIKPAL_WEB_MODE_PROVIDER_SWITCH_FADE_SECONDS=0.16
TIKPAL_WEB_MODE_TRANSITION_MIN_VISIBLE_SECONDS=0.5
TIKPAL_WEB_MODE_STAGE_POSITION=2560,0
TIKPAL_WEB_MODE_STAGE_REVEAL_MS=650
TIKPAL_WEB_MODE_AUDIO_CROSSFADE_ENABLED=1
TIKPAL_WEB_MODE_AUDIO_CROSSFADE_MS=2000
TIKPAL_WEB_MODE_LOCK_TIMEOUT_SECONDS=2
TIKPAL_WEB_MODE_ONBOARD_LOCK_TIMEOUT_SECONDS=1
TIKPAL_WEB_MODE_ONBOARD=1
TIKPAL_WEB_MODE_ONBOARD_AUTO_FOCUS=1
TIKPAL_WEB_MODE_ONBOARD_WINDOW=900x280
TIKPAL_WEB_MODE_ONBOARD_POSITION=500,420
TIKPAL_WEB_MODE_ALSA_OUTPUT_DEVICE=auto
TIKPAL_WEB_MODE_WINDOW_GUARD=1
TIKPAL_WEB_MODE_SINGLE_PROVIDER_WINDOW=1
TIKPAL_WEB_MODE_X11_SYNC_WINDOW_OPS=0
# Native X11 mutation stays disabled until local/Xvfb gates and the staged 115 canaries pass.
TIKPAL_WEB_MODE_X11_HELPER_MODE=disabled
# The Helper itself is read-only in Phase 0. Set to 1 only for an approved Phase 1 canary.
TIKPAL_X11_HELPER_PHASE=0
TIKPAL_WEB_MODE_X11_HELPER_BINARY=/usr/local/libexec/tikpal-x11-helper
TIKPAL_WEB_MODE_X11_HELPER_SOCKET=/run/tikpal/x11-helper.sock
TIKPAL_WEB_MODE_X11_HELPER_CONNECT_TIMEOUT_MS=50
TIKPAL_WEB_MODE_X11_HELPER_RESPONSE_TIMEOUT_MS=300
# Opt-in diagnostic JSONL; leave empty during normal kiosk operation.
TIKPAL_WEB_MODE_X11_MUTATION_TRACE_PATH=
# Independent initial-entry step trace; the configured file must already be writable.
TIKPAL_WEB_MODE_INITIAL_ENTRY_TRACE_PATH=
TIKPAL_WEB_MODE_PROVIDER_POOL=1
TIKPAL_WEB_MODE_PROVIDER_IDLE_POOL_ENABLED=1
TIKPAL_WEB_MODE_PROVIDER_PREWARM_ENABLED=1
TIKPAL_WEB_MODE_PROVIDER_PREWARM_CONTINUE_AFTER_CLOSE=0
TIKPAL_WEB_MODE_PROVIDER_PREWARM_DELAY_SECONDS=0.4
TIKPAL_WEB_MODE_PROVIDER_PREWARM_MAX_CONCURRENT_LAUNCHES=3
TIKPAL_WEB_MODE_PROVIDER_PREWARM_LOCK_TIMEOUT_SECONDS=2
# Background provider guards use a slower CDP poll; the active provider stays at 250ms.
TIKPAL_WEB_MODE_PROVIDER_GUARD_IDLE_POLL_MS=2000
# Bounded injection fallback only when a resident page lost its audio gate.
TIKPAL_WEB_MODE_TARGET_AUDIO_GATE_PRIME_FALLBACK_TIMEOUT_SECONDS=0.8
# Hot switch ownership marker; keep it on tmpfs so storage I/O cannot delay a reveal.
TIKPAL_WEB_MODE_PROVIDER_SWITCH_MARKER_PATH=/run/tikpal/provider-switch.pid
TIKPAL_WEB_MODE_BOOT_PREWARM_ENABLED=1
TIKPAL_WEB_MODE_BOOT_PREWARM_READY_TIMEOUT_SECONDS=30
TIKPAL_WEB_MODE_BOOT_PREWARM_INITIAL_DELAY_SECONDS=3
TIKPAL_WEB_MODE_POPUP_BLOCKING=1
TIKPAL_WEB_MODE_PROVIDER_DEBUG_PORT=9234
TIKPAL_WEB_MODE_PROVIDER_GUARD=1
# Persistent browser-level CDP sessions are opt-in until the scoped Phase 4
# canary and 20-round physical acceptance have passed.
TIKPAL_WEB_MODE_CDP_SESSION_MANAGER=0
TIKPAL_WEB_MODE_CDP_SESSION_MANAGER_SOCKET=/run/tikpal/cdp-session-manager.sock
# Keep every resident Provider and its login state, but freeze inactive ready
# pages after a short idle period when the CDP lifecycle API is available.
TIKPAL_WEB_MODE_PROVIDER_BACKGROUND_FREEZE_ENABLED=0
TIKPAL_WEB_MODE_PROVIDER_BACKGROUND_FREEZE_DELAY_SECONDS=8
TIKPAL_WEB_MODE_DISABLE_HANG_MONITOR=1
TIKPAL_WEB_MODE_ERROR_PAGE_URL=http://127.0.0.1:4173/web-mode-error.html
TIKPAL_WEB_MODE_QQ_AUTO_CONFIRM=1
TIKPAL_WEB_MODE_QQ_AUDIO_PRIME=1
TIKPAL_WEB_MODE_QQ_MUSIC_AUTO_PLAY=1

TIKPAL_KIOSK_VIEWER=none
TIKPAL_KIOSK_NOVNC_ADDRESS=0.0.0.0
TIKPAL_KIOSK_NOVNC_PORT=6080
TIKPAL_KIOSK_VNC_ADDRESS=127.0.0.1
TIKPAL_KIOSK_VNC_PORT=5900

TIKPAL_KIOSK_WATCHDOG_ENABLED=1
TIKPAL_KIOSK_WATCHDOG_FAILURE_THRESHOLD=1
TIKPAL_KIOSK_WATCHDOG_RESTART_COOLDOWN_SECONDS=120
TIKPAL_KIOSK_WATCHDOG_REBOOT_AFTER_RESTARTS=3
TIKPAL_KIOSK_WATCHDOG_REBOOT_WINDOW_SECONDS=900
TIKPAL_KIOSK_WATCHDOG_REBOOT_COMMAND="systemctl reboot"
TIKPAL_KIOSK_WATCHDOG_X_TIMEOUT_SECONDS=5
TIKPAL_KIOSK_WATCHDOG_WEB_TIMEOUT_SECONDS=3
TIKPAL_KIOSK_WATCHDOG_GPU_LOG_SCAN=1
TIKPAL_KIOSK_WATCHDOG_PAGE_HEARTBEAT_ENABLED=1
TIKPAL_KIOSK_WATCHDOG_PAGE_HEARTBEAT_URL=http://127.0.0.1:8787/api/v1/kiosk/heartbeat
TIKPAL_KIOSK_WATCHDOG_WEB_MODE_HEARTBEAT_BYPASS=1
TIKPAL_KIOSK_PHYSICAL_DISPLAY_CHECK_ENABLED=0
TIKPAL_KIOSK_PHYSICAL_DISPLAY_SOFT_KICK_BEFORE_RESTART=1
TIKPAL_KIOSK_PHYSICAL_DISPLAY_GPU_REBIND_BEFORE_RESTART=0
TIKPAL_KIOSK_PHYSICAL_DISPLAY_PREPARE_COMMAND=/usr/local/sbin/tikpal-physical-display-prepare
TIKPAL_KIOSK_WATCHDOG_DRY_RUN=0
TIKPAL_KIOSK_HEARTBEAT_HIDDEN_STALE_MS=120000

TIKPAL_RENDERER=media
TIKPAL_RENDER_PROFILE=pi4-media
