  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  }
