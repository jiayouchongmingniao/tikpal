[Unit]
Description=Tikpal Chromium kiosk
After=network.target tikpal-audio-adapt.service tikpal-api.service tikpal-web.service tikpal-kiosk-performance.service
Wants=network.target tikpal-audio-adapt.service tikpal-api.service tikpal-web.service tikpal-kiosk-performance.service

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=-@APP_DIR@/.env.kiosk
Environment=TIKPAL_KIOSK_SKIP_ENV_SOURCE=1
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/@SERVICE_USER@/.Xauthority
StandardOutput=journal
StandardError=journal
ExecStart=@APP_DIR@/deploy/chromium/start-tikpal-kiosk-display.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
