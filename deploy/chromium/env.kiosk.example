# Copy to <app dir>/.env.kiosk on the Raspberry Pi and adjust only what differs.

TIKPAL_KIOSK_URL=http://localhost:4173/
TIKPAL_KIOSK_WINDOW=2560x720
TIKPAL_KIOSK_WINDOW_POSITION=0,0
TIKPAL_KIOSK_DISPLAY=:0
TIKPAL_KIOSK_DISPLAY_MODE=auto
TIKPAL_KIOSK_LOCAL_SCREEN=auto
TIKPAL_KIOSK_XRANDR_MODE=2560x720
TIKPAL_KIOSK_XRANDR_OUTPUT=HDMI-1
TIKPAL_KIOSK_VIRTUAL_DEPTH=24

TIKPAL_CHROMIUM_BIN=/usr/lib/chromium-browser/chromium-browser
TIKPAL_CHROMIUM_PROFILE_DIR=/home/moode/.config/tikpal-chromium-kiosk
TIKPAL_CHROMIUM_COLOR_SCHEME=dark
# Route Chromium media audio through moOde's selected output.
TIKPAL_CHROMIUM_ALSA_OUTPUT_DEVICE=_audioout
TIKPAL_KIOSK_REMOTE_DEBUG=0
TIKPAL_KIOSK_REMOTE_DEBUG_ADDRESS=0.0.0.0
TIKPAL_KIOSK_REMOTE_DEBUG_PORT=9222
TIKPAL_KIOSK_REMOTE_DEBUG_CHROMIUM_ADDRESS=127.0.0.1
TIKPAL_KIOSK_REMOTE_DEBUG_CHROMIUM_PORT=9223
TIKPAL_KIOSK_VIEWER=novnc
TIKPAL_KIOSK_NOVNC_ADDRESS=0.0.0.0
TIKPAL_KIOSK_NOVNC_PORT=6080
TIKPAL_KIOSK_VNC_ADDRESS=127.0.0.1
TIKPAL_KIOSK_VNC_PORT=5900

TIKPAL_RENDERER=media
TIKPAL_RENDER_PROFILE=pi4-media
