+static u8 display_default_backlight_value(void)
+{
+    const char *raw = getenv("TIKPAL_TURZX_DEFAULT_BRIGHTNESS");
+    char *end = NULL;
+    long value;
+
+    if (!raw || !*raw)
+        return 45;
+
+    errno = 0;
+    value = strtol(raw, &end, 10);
+    if (errno || end == raw)
+        return 45;
+    if (value < 1)
+        return 1;
+    if (value > 100)
+        return 100;
+
+    return (u8)value;
 }
 
