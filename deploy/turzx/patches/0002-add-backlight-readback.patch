+int display_read_backlight_value(struct display_device *udl, u8 *value)
+{
+    u8 buf[4] = {0};
+    int ret;
+
+    if (!udl->devh || !value)
+        return -ENODEV;
+
+    ret = libusb_control_transfer(udl->devh,
+                  LIBUSB_ENDPOINT_IN | LIBUSB_REQUEST_TYPE_VENDOR | LIBUSB_RECIPIENT_INTERFACE,
+                  DISPLAY_REQ_GET_BACKLIGHT, 0, udl->iface_num,
+                  buf, sizeof(buf), DISPLAY_USB_CTRL_TIMEOUT_MS);
+    if (ret <= 0)
+        return ret;
+
+    *value = display_clamp_backlight_value(buf[0]);
+    return 0;
+}
