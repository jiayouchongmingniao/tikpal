+static void display_pm_write_ack(struct display_manager *mgr, bool ok)
+{
+    ssize_t wr;
+
+    wr = write(mgr->pm_fifo_out_fd, ok ? "A" : "E", 1);
+    if (wr < 0 && errno != EAGAIN && errno != EWOULDBLOCK)
+        LOGE(NULL, "pm ack write failed: %s\n", strerror(errno));
+}
+
+static int display_pm_parse_backlight_value(const char *cmd)
+{
+    char *end = NULL;
+    long value;
+
+    if (!cmd || cmd[0] != 'B')
+        return -EINVAL;
+
+    errno = 0;
+    value = strtol(cmd + 1, &end, 10);
+    if (errno || end == cmd + 1)
+        return -EINVAL;
+    while (*end == ' ' || *end == '\t' || *end == '\r' || *end == '\n')
+        end++;
+    if (*end)
+        return -EINVAL;
+    if (value < 0 || value > 100)
+        return -ERANGE;
+    if (value < 1)
+        value = 1;
+
+    return (int)value;
 }
 
