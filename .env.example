TIKPAL_API_HOST=127.0.0.1
TIKPAL_API_PORT=8787
TIKPAL_WEB_HOST=0.0.0.0
TIKPAL_WEB_PORT=4173
TIKPAL_WEB_REMOTE_PORT=4174
TIKPAL_API_ORIGIN=http://127.0.0.1:8787
TIKPAL_PORTABLE_API_KEY=
TIKPAL_UI_PREFERENCES_STATE_PATH=.tikpal/ui-preferences.json
# Optional runtime hook used after the local kiosk changes the device language.
# `%LOCALE%` and `%INPUT_METHOD%` are replaced before the command runs.
TIKPAL_UI_INPUT_METHOD_SYNC_COMMAND=

# Player bridge
# Use `mock` for local UI development. Use `mpc` on the moOde Pi.
TIKPAL_PLAYER_BACKEND=mock
TIKPAL_MPD_HOST=127.0.0.1
TIKPAL_MPD_PORT=6600
TIKPAL_MPC_BIN=mpc
TIKPAL_MPC_SEEK_TIMEOUT_MS=10000
TIKPAL_MPD_DEFAULT_QUEUE_PATH=Codex
# Startup anti-blast guard: primes MPD and, when configured, the physical output helper.
# This does not overwrite the user's remembered nonzero playback volume.
TIKPAL_MPD_STARTUP_VOLUME=30
TIKPAL_STARTUP_SCENE_SOUND_ENABLED=1
# On a moOde Pi with ALSA Loopback enabled, plain `amixer get PCM` may control
# the Loopback card instead of the physical output. The helper follows moOde's
# current `_audioout` ALSA config and mirrors writes to Loopback for spectrum.
# Tikpal's Loopback helper rejects HDMI-only `_audioout` routes by default so
# USB speakers or amplifiers stay the normal physical output. Set this to 1
# only when the install intentionally plays through HDMI.
TIKPAL_AUDIO_ADAPT_MODE=auto
TIKPAL_AUDIO_CARD_PRIORITY=BT66,Crimson
TIKPAL_AUDIO_CARD_FORCE=
TIKPAL_AUDIO_ALLOW_UNKNOWN_SINGLE=1
TIKPAL_ALSA_LOOPBACK_ALLOW_HDMI=0
TIKPAL_OUTPUT_VOLUME_GET_COMMAND="./deploy/moode/tikpal-output-volume.sh get"
TIKPAL_OUTPUT_VOLUME_SET_COMMAND="./deploy/moode/tikpal-output-volume.sh set %VALUE%"
TIKPAL_OUTPUT_VOLUME_CONTROLS="PCM,Master,Digital,Speaker,Headphone,Line Out"
TIKPAL_OUTPUT_VOLUME_FALLBACK_MPC=1
TIKPAL_KIOSK_AUDIO_RELEASE_COMMAND="./deploy/moode/tikpal-release-kiosk-audio.sh"
TIKPAL_KIOSK_AUDIO_RELEASE_SETTLE_MS=250
TIKPAL_HIFI_EQ_APPLY_COMMAND=
# On the moOde Pi, point this at the repo helper after the playback output is
# mirrored to a readable ALSA capture device.
TIKPAL_HIFI_SPECTRUM_COMMAND=
TIKPAL_HIFI_SPECTRUM_DEVICE=
TIKPAL_HIFI_SPECTRUM_CAPTURE_COMMAND=
TIKPAL_HIFI_SPECTRUM_CACHE_MS=900
TIKPAL_HIFI_SPECTRUM_GAIN=12
TIKPAL_STATE_SNAPSHOT_REFRESH_MS=3000
TIKPAL_HIFI_RUNTIME_RECOVERY_COOLDOWN_MS=10000
TIKPAL_HIFI_RUNTIME_RECOVERY_MUTATION_QUIET_MS=8000
TIKPAL_DDCUTIL_BIN=ddcutil
TIKPAL_DDCUTIL_DISPLAY=
TIKPAL_DDCUTIL_READ_CACHE_MS=300000
TIKPAL_DDCUTIL_READ_TIMEOUT_MS=3500
TIKPAL_DDCUTIL_SUPPRESS_READ_WARNINGS=1
TIKPAL_DDCUTIL_SUPPRESS_SYSLOG=1
# Gentoo TURZX/EVDI USB screen backlight. Leave blank unless the driver patch
# and root-owned helper are installed; Tikpal only uses it when a DVI-I/DVI-D
# TURZX RandR output is the primary display.
TIKPAL_TURZX_BRIGHTNESS_COMMAND=
TIKPAL_TURZX_BRIGHTNESS_TIMEOUT_MS=2500
TIKPAL_TURZX_DEFAULT_BRIGHTNESS=45
# Current 1a86:ad11 EVDI panels blank briefly when probed through the vendor
# brightness command. Keep hardware writes off unless a new panel is verified.
TIKPAL_TURZX_HARDWARE_BRIGHTNESS_ENABLED=0
# Used only when TURZX hardware backlight readback does not follow writes.
TIKPAL_TURZX_SOFT_BRIGHTNESS_MIN=0.35
# Kiosk display settings. Chromium binary path and xrandr output/mode/rate.
# IMPORTANT: in .env.kiosk, leave these EMPTY to use script defaults (auto, 2560x720, 29.95).
# Setting an explicit empty value (e.g. TIKPAL_KIOSK_XRANDR_OUTPUT=) overrides the default
# and breaks mode detection. Only set these when the device needs a non-default value.
TIKPAL_CHROMIUM_BIN=
TIKPAL_KIOSK_XRANDR_OUTPUT=
TIKPAL_KIOSK_XRANDR_MODE=
TIKPAL_KIOSK_XRANDR_RATE=
TIKPAL_PHYSICAL_DISPLAY_ALLOW_NO_EDID=0
# DRM connector preference for physical display detection. The script scans
# these first, then falls back to all connected outputs.
# Gentoo: card1-DVI-I-1 (USB TURZX screen on DVI-I-1-1).
TIKPAL_PHYSICAL_DISPLAY_DRM_PREFERRED_CONNECTORS=card0-HDMI-A-1 card0-HDMI-A-2
TIKPAL_RUNTIME_DRM_MODE_ENABLED=1
TIKPAL_RADIO_DEFAULT_URI=
TIKPAL_RADIO_LABEL="Last Station"
TIKPAL_RADIO_LOGO_DIR=/var/local/www/imagesw/radio-logos
TIKPAL_RADIO_VOLUME_DEFAULT_PERCENT=35
TIKPAL_RADIO_AUTO_SKIP_VERIFY_WINDOW_MS=1500
TIKPAL_RADIO_AUTO_SKIP_POST_START_SETTLE_MS=500
TIKPAL_RADIO_AUTO_SKIP_RETRY_DELAYS_MS=
TIKPAL_RADIO_LATE_PLAY_NUDGE_DELAYS_MS=1500,3000,5000,8000,12000,16000
TIKPAL_SPOTIFY_READY_COMMAND="./deploy/moode/tikpal-spotify-ready.sh"
TIKPAL_SPOTIFY_ACTIVE_COMMAND="./deploy/moode/tikpal-spotify-active.sh"
TIKPAL_SPOTIFY_ACTIVATE_COMMAND="./deploy/moode/tikpal-spotify-enable.sh"
TIKPAL_SPOTIFY_DISABLE_COMMAND="./deploy/moode/tikpal-spotify-disable.sh"
TIKPAL_SPOTIFY_LABEL_COMMAND="./deploy/moode/tikpal-spotify-label.sh"
TIKPAL_SPOTIFY_ZEROCONF_PORT=9000
TIKPAL_BLUETOOTH_READY_COMMAND=
TIKPAL_BLUETOOTH_ACTIVE_COMMAND=
TIKPAL_BLUETOOTH_DEVICE_NAME=Tikpal-Speaker-Bluetooth
TIKPAL_BLUETOOTH_ENABLE_COMMAND="./deploy/moode/tikpal-bluetooth-enable.sh"
TIKPAL_BLUETOOTH_DISABLE_COMMAND="moodeutl -Ro --bluetooth off"
TIKPAL_BLUETOOTH_LABEL_COMMAND="./deploy/moode/tikpal-bluetooth-label.sh"
TIKPAL_BLUETOOTH_LABEL_TIMEOUT_SECONDS=2
TIKPAL_BLUETOOTH_METADATA_COMMAND="./deploy/moode/tikpal-bluetooth-metadata.sh"
TIKPAL_BLUETOOTH_LYRICS_UNRELIABLE_DURATION_MS=90000
TIKPAL_BLUETOOTH_CAPTURE_COMMAND="./deploy/moode/tikpal-bluetooth-capture.sh"
TIKPAL_BLUETOOTH_CAPTURE_DURATION_SECONDS=10
TIKPAL_BLUETOOTH_RECOGNITION_SETTLE_MS=4000
TIKPAL_BLUETOOTH_RECOGNITION_RETRY_MS=45000
TIKPAL_BLUETOOTH_RECOGNITION_NOT_FOUND_RETRY_MS=30000
TIKPAL_AIRPLAY_READY_COMMAND="./deploy/moode/tikpal-airplay-state.sh ready"
TIKPAL_AIRPLAY_ACTIVE_COMMAND="./deploy/moode/tikpal-airplay-state.sh active"
TIKPAL_AIRPLAY_ENABLE_COMMAND="./deploy/moode/tikpal-airplay-enable.sh"
TIKPAL_AIRPLAY_DISABLE_COMMAND="moodeutl -Ro --airplay off"
TIKPAL_AIRPLAY_RECEIVER_ACTIVE_COMMAND="./deploy/moode/tikpal-airplay-state.sh receiver"
TIKPAL_AIRPLAY_SERVICE_NAME=Tikpal-Speaker-Airplay
TIKPAL_AIRPLAY_SERVICE_TYPE=classic
TIKPAL_AIRPLAY_LABEL_COMMAND="./deploy/moode/tikpal-airplay-label.sh"
TIKPAL_AIRPLAY_ALSA_OUTPUT_DEVICE=_audioout
TIKPAL_AIRPLAY_IGNORE_VOLUME_CONTROL=no
TIKPAL_AIRPLAY_DEFAULT_VOLUME_DB=0.0
TIKPAL_AIRPLAY_VOLUME_RANGE_DB=30
TIKPAL_AIRPLAY_VOLUME_CONTROL_PROFILE=flat
TIKPAL_AIRPLAY_METADATA_COMMAND="./deploy/moode/tikpal-airplay-metadata.sh"
TIKPAL_AIRPLAY_METADATA_PIPE=/tmp/shairport-sync-metadata
TIKPAL_AIRPLAY_TRANSPORT_AVAILABLE_COMMAND="./deploy/moode/tikpal-airplay-transport.sh available"
TIKPAL_AIRPLAY_PLAY_PAUSE_COMMAND="./deploy/moode/tikpal-airplay-transport.sh play-pause"
TIKPAL_AIRPLAY_PLAY_COMMAND="./deploy/moode/tikpal-airplay-transport.sh play"
TIKPAL_AIRPLAY_PAUSE_COMMAND="./deploy/moode/tikpal-airplay-transport.sh pause"
TIKPAL_AIRPLAY_NEXT_COMMAND="./deploy/moode/tikpal-airplay-transport.sh next"
TIKPAL_AIRPLAY_PREVIOUS_COMMAND="./deploy/moode/tikpal-airplay-transport.sh previous"
TIKPAL_AIRPLAY_METADATA_MAX_AGE_SECONDS=300
TIKPAL_AIRPLAY_ARTWORK_MAX_LAG_SECONDS=1
TIKPAL_AIRPLAY_METADATA_CLOCK_LEAD_MS=1000
TIKPAL_AIRPLAY_BUSCTL_BIN=busctl
TIKPAL_AIRPLAY_DIRECT_METADATA_REFRESH_MIN_MS=1000
TIKPAL_AIRPLAY_CAPTURE_COMMAND=
TIKPAL_AIRPLAY_CAPTURE_DURATION_SECONDS=6
TIKPAL_AIRPLAY_RECOGNITION_SETTLE_MS=1000
TIKPAL_UPNP_READY_COMMAND="./deploy/moode/tikpal-upnp-ready.sh"
TIKPAL_UPNP_ACTIVE_COMMAND=
TIKPAL_UPNP_CONFIGURE_COMMAND="./deploy/moode/tikpal-upnp-configure.sh"
TIKPAL_UPNP_FRIENDLY_NAME=
TIKPAL_UPNP_AV_FRIENDLY_NAME=
TIKPAL_UPNP_CHECK_CONTENT_FORMAT=0
TIKPAL_UPNP_ENABLE_COMMAND="./deploy/moode/tikpal-upnp-enable.sh"
TIKPAL_UPNP_DISABLE_COMMAND="./deploy/moode/tikpal-upnp-disable.sh"
TIKPAL_UPNP_LABEL_COMMAND="./deploy/moode/tikpal-upnp-label.sh"
TIKPAL_UPNP_METADATA_COMMAND="./deploy/moode/tikpal-upnp-metadata.sh"
TIKPAL_UPNP_CAPTURE_COMMAND=
TIKPAL_UPNP_CAPTURE_DURATION_SECONDS=6
TIKPAL_UPNP_RECOGNITION_SETTLE_MS=1000
TIKPAL_MULTIROOM_ROON_SERVICE=roonbridge.service
TIKPAL_MULTIROOM_ROON_READY_COMMAND="./deploy/moode/tikpal-multiroom-state.sh roon ready"
TIKPAL_MULTIROOM_ROON_ACTIVE_COMMAND="./deploy/moode/tikpal-multiroom-state.sh roon active"
TIKPAL_MULTIROOM_ROON_ENABLE_COMMAND="./deploy/moode/tikpal-multiroom-state.sh roon enable"
TIKPAL_MULTIROOM_ROON_DISABLE_COMMAND="./deploy/moode/tikpal-multiroom-state.sh roon disable"
TIKPAL_MULTIROOM_ROON_LABEL_COMMAND="./deploy/moode/tikpal-multiroom-state.sh roon label"
TIKPAL_MULTIROOM_LYRION_SERVICE=squeezelite.service
TIKPAL_MULTIROOM_LYRION_READY_COMMAND="./deploy/moode/tikpal-multiroom-state.sh lyrion ready"
TIKPAL_MULTIROOM_LYRION_ACTIVE_COMMAND="./deploy/moode/tikpal-multiroom-state.sh lyrion active"
TIKPAL_MULTIROOM_LYRION_ENABLE_COMMAND="./deploy/moode/tikpal-multiroom-state.sh lyrion enable"
TIKPAL_MULTIROOM_LYRION_DISABLE_COMMAND="./deploy/moode/tikpal-multiroom-state.sh lyrion disable"
TIKPAL_MULTIROOM_LYRION_LABEL_COMMAND="./deploy/moode/tikpal-multiroom-state.sh lyrion label"
TIKPAL_MULTIROOM_TIKPAL_SERVICE=tikpal-multiroom.service
TIKPAL_MULTIROOM_TIKPAL_READY_COMMAND="./deploy/moode/tikpal-multiroom-state.sh tikpal ready"
TIKPAL_MULTIROOM_TIKPAL_ACTIVE_COMMAND="./deploy/moode/tikpal-multiroom-state.sh tikpal active"
TIKPAL_MULTIROOM_TIKPAL_ENABLE_COMMAND="./deploy/moode/tikpal-multiroom-state.sh tikpal enable"
TIKPAL_MULTIROOM_TIKPAL_DISABLE_COMMAND="./deploy/moode/tikpal-multiroom-state.sh tikpal disable"
TIKPAL_MULTIROOM_TIKPAL_LABEL_COMMAND="./deploy/moode/tikpal-multiroom-state.sh tikpal label"
TIKPAL_ROONBRIDGE_SERVICE=roonbridge.service
TIKPAL_ROONBRIDGE_READY_COMMAND="./deploy/moode/tikpal-roonbridge-state.sh ready"
TIKPAL_ROONBRIDGE_ACTIVE_COMMAND="./deploy/moode/tikpal-roonbridge-state.sh active"
TIKPAL_ROONBRIDGE_ENABLE_COMMAND="./deploy/moode/tikpal-roonbridge-state.sh enable"
TIKPAL_ROONBRIDGE_DISABLE_COMMAND="./deploy/moode/tikpal-roonbridge-state.sh disable"
TIKPAL_ROONBRIDGE_LABEL_COMMAND="./deploy/moode/tikpal-roonbridge-state.sh label"
TIKPAL_AUDIO_OUTPUT_PROFILE_COMMAND="./deploy/moode/tikpal-audio-output-profile.sh %PROFILE%"
TIKPAL_MPD_BITPERFECT_PROFILE_COMMAND="./deploy/moode/tikpal-mpd-bitperfect-profile.sh %MODE%"
TIKPAL_MPD_STANDARD_ALSA_DEVICE=_audioout
TIKPAL_MPD_PURE_ALSA_DEVICE=
TIKPAL_MPD_BITPERFECT_ALSA_DEVICE=
TIKPAL_MPD_SLEEP_SAMPLE_RATE=48000
TIKPAL_MPD_SLEEP_VOLUME_LIMIT=45
TIKPAL_MPD_CUSTOM_OUTPUT_NAME="Tikpal Custom"
TIKPAL_MPD_CUSTOM_ALSA_DEVICE=_audioout
TIKPAL_MPD_CUSTOM_PURE_DIRECT=0
TIKPAL_MPD_CUSTOM_VOLUME_NORMALIZATION=1
TIKPAL_MPD_CUSTOM_SMOOTH_TRANSITION=1
TIKPAL_MPD_CUSTOM_AUTOMATIC_SAMPLE_RATE=1
TIKPAL_MPD_CUSTOM_DSD_MODE=0
TIKPAL_MPD_CUSTOM_PLAYBACK_STABILITY=1
TIKPAL_MPD_CUSTOM_MIXER_TYPE=
TIKPAL_MPD_CUSTOM_REPLAY_GAIN_HANDLER=
TIKPAL_MPD_CUSTOM_FORMAT=
TIKPAL_MPD_CUSTOM_FIXED_SAMPLE_RATE=48000
TIKPAL_MPD_CUSTOM_REPLAYGAIN=
TIKPAL_MPD_CUSTOM_CROSSFADE=
TIKPAL_RECOGNITION_PROVIDER=acrcloud
TIKPAL_ACRCLOUD_HOST=
TIKPAL_ACRCLOUD_ACCESS_KEY=
TIKPAL_ACRCLOUD_ACCESS_SECRET=
TIKPAL_LYRICS_PROVIDER_CHAIN=lrclib,lyricsovh
TIKPAL_LRCLIB_BASE_URL=https://lrclib.net
TIKPAL_LYRICS_OVH_BASE_URL=https://api.lyrics.ovh
TIKPAL_LYRICS_CUSTOM_URL_TEMPLATE=
TIKPAL_LYRICS_CUSTOM_AUTH_HEADER=

# Explore web players
TIKPAL_WEB_MODE_DEFAULT_PROXY_URL=http://127.0.0.1:7897
TIKPAL_WEB_MODE_PROVIDER_TEXT_SCALE=1.10
TIKPAL_WEB_MODE_KEYBOARD_STICKY_PROTECT_MS=60000
TIKPAL_WEB_MODE_ENTRY_PROVIDER_PAINT_TIMEOUT_SECONDS=1.5
TIKPAL_WEB_MODE_ENTRY_REVEAL_SETTLE_SECONDS=0.45
TIKPAL_WEB_MODE_RESIDENT_SWITCH_PAINT_TIMEOUT_SECONDS=0.6
TIKPAL_WEB_MODE_RESIDENT_SWITCH_PAINT_POLL_SECONDS=0.08
TIKPAL_WEB_MODE_CLOSE_WARM_ENABLED=1
TIKPAL_WEB_MODE_CLOSE_KEEP_RESIDENT=1
TIKPAL_WEB_MODE_CLOSE_WARM_TTL_SECONDS=45
TIKPAL_WEB_MODE_CLOSE_AUDIO_GATE_SETTLE_SECONDS=0.35
TIKPAL_WEB_MODE_X11_SYNC_WINDOW_OPS=0
TIKPAL_WEB_MODE_PROVIDER_IDLE_POOL_ENABLED=1
TIKPAL_WEB_MODE_BOOT_PREWARM_ENABLED=1
TIKPAL_WEB_MODE_BOOT_PREWARM_READY_TIMEOUT_SECONDS=30
TIKPAL_WEB_MODE_BOOT_PREWARM_INITIAL_DELAY_SECONDS=3
TIKPAL_WEB_MODE_PROVIDER_PREWARM_MAX_CONCURRENT_LAUNCHES=3
TIKPAL_WEB_MODE_QQ_AUDIO_PRIME=1
TIKPAL_WEB_MODE_QQ_MUSIC_AUTO_PLAY=1

# Optional system integration
# Leave unset for local development. Override these on the Pi when systemctl
# requires a different command or sudo wrapper.
TIKPAL_LIBRARY_SCAN_COMMAND=
TIKPAL_LOCAL_LIBRARY_SOURCE_ROOT=
TIKPAL_LOCAL_LIBRARY_MPD_PREFIX=Codex
TIKPAL_LOCAL_LIBRARY_IMPORTS_DIR_NAME="USB Imports"
TIKPAL_MPD_LIBRARY_OWNER=mpd:audio
TIKPAL_USB_LIBRARY_SCAN_COMMAND="./deploy/moode/tikpal-usb-library-sync.sh"
TIKPAL_USB_LIBRARY_AUTO_UPDATE=0
TIKPAL_USB_LIBRARY_AUTO_UPDATE_MIN_MS=15000
TIKPAL_MPC_UPDATE_TIMEOUT_SECONDS=8
TIKPAL_USB_LIBRARY_ROOTS=
TIKPAL_USB_LIBRARY_AUTO_ROOTS=/media,/run/media
TIKPAL_USB_LIBRARY_MPD_PREFIX=USB
TIKPAL_USB_LIBRARY_MAX_TRACKS=500
TIKPAL_NAS_LIBRARY_ROOTS=
TIKPAL_NAS_LIBRARY_MPD_PREFIX=NAS
TIKPAL_NAS_LIBRARY_MAX_TRACKS=500
TIKPAL_NAS_SOURCES_STATE_PATH=
TIKPAL_NAS_CREDENTIALS_DIR=
TIKPAL_NAS_MOUNT_ROOT=/mnt/tikpal-nas
TIKPAL_NAS_MPD_ENTRY_ROOT=
# Leave blank to use Tikpal's default read-only CIFS mount flow. Set these to a
# root-owned sudo helper when a host needs custom mount/unmount policy.
# Gentoo example: sudo -n -E /usr/local/sbin/tikpal-nas-mount mount
TIKPAL_NAS_MOUNT_COMMAND=
# Gentoo example: sudo -n -E /usr/local/sbin/tikpal-nas-mount unmount
TIKPAL_NAS_UNMOUNT_COMMAND=
# Optional discovery helpers. Discovery only proposes candidates; it never
# saves, mounts, or scans without a user Test + Save & Scan.
TIKPAL_NAS_DISCOVERY_COMMAND=
TIKPAL_NAS_DISCOVERY_HINTS=
TIKPAL_SYSTEM_REBOOT_COMMAND="sudo -n systemctl --no-wall --no-block reboot"
TIKPAL_SYSTEM_SHUTDOWN_COMMAND="sudo -n systemctl --no-wall --no-block poweroff"
TIKPAL_DSP_PRESET=Unknown

# Explore web-mode command override. Defaults to ./deploy/chromium/tikpal-web-mode.sh
# in mpc mode. Set to empty to disable Explore.
TIKPAL_WEB_MODE_COMMAND=
TIKPAL_WEB_MODE_COMMAND_TIMEOUT_MS=45000
TIKPAL_WEB_MODE_OPEN_COMMAND_TIMEOUT_MS=110000
TIKPAL_WEB_MODE_PROXY_TEST_URL=https://open.spotify.com/
TIKPAL_WEB_MODE_PROXY_TEST_NETWORK=0

# Audio source (generic external audio input, e.g. USB DAC line-in).
# Leave empty on devices without a dedicated audio input source.
TIKPAL_AUDIO_ACTIVATE_COMMAND=
TIKPAL_AUDIO_READY_COMMAND=
TIKPAL_AUDIO_ACTIVE_COMMAND=
TIKPAL_AUDIO_LABEL_COMMAND=

# Media processing binaries. Defaults to ffmpeg/ffprobe in PATH.
TIKPAL_FFMPEG_BIN=ffmpeg
TIKPAL_FFPROBE_BIN=ffprobe
