+
+static u8 display_clamp_backlight_value(u8 value)
+{
+    if (value < 1)
+        return 1;
+    if (value > 100)
+        return 100;
+    return value;
+}
+
+u8 display_get_backlight_value(struct display_device *udl)
+{
+    u8 value;
+
+    pthread_mutex_lock(&udl->backlight_lock);
+    value = udl->backlight_value;
+    pthread_mutex_unlock(&udl->backlight_lock);
+
+    return display_clamp_backlight_value(value);
+}
+
+int display_set_backlight_value(struct display_device *udl, u8 value)
+{
+    struct libusb_transfer *urb;
+    char *wrptr;
+    int ret;
+
+    value = display_clamp_backlight_value(value);
+    pthread_mutex_lock(&udl->backlight_lock);
+    udl->backlight_value = value;
+    pthread_mutex_unlock(&udl->backlight_lock);
+
+    if (!udl->devh || udl->blank_mode != DRM_MODE_DPMS_ON)
+        return 0;
+
+    urb = display_get_urb(udl);
+    if (!urb)
+        return -EAGAIN;
+
+    wrptr = (char *)urb->buffer;
+    wrptr = display_set_blank_mode(wrptr, DRM_MODE_DPMS_ON);
+    wrptr = display_set_blank_value(wrptr, value);
+    ret = display_submit_urb(udl, &wrptr, &urb, NULL);
+    if (ret) {
+        LOGE(udl, "set backlight value failed: %d\n", ret);
+        return ret;
+    }
+    display_sync_pending_urbs(udl, DEFAULT_TIMEOUT_S);
+    return 0;
 }
 
