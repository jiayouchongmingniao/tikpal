{
  "manifest_version": 3,
  "name": "Tikpal Explore Guard",
  "version": "1.1.3",
  "key": "",
  "permissions": ["proxy", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://127.0.0.1:4173/*",
    "http://localhost:4173/*",
    "https://*.music.126.net/*",
    "https://*.music.163.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["netease-audio-mirror.js"],
      "matches": ["https://music.163.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
