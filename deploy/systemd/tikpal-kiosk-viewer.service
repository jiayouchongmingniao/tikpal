[Unit]
Description=Tikpal kiosk noVNC viewer
After=network.target tikpal-kiosk.service
Wants=network.target tikpal-kiosk.service
PartOf=tikpal-kiosk.service

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=-@APP_DIR@/.env.kiosk
EnvironmentFile=-@APP_DIR@/.env.kiosk.viewer
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/@SERVICE_USER@/.Xauthority
StandardOutput=journal
StandardError=journal
ExecStart=@APP_DIR@/deploy/chromium/start-tikpal-kiosk-viewer.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
