@@ -301,7 +301,10 @@
     return false;
   }
   auto* factory = ui::OzonePlatform::GetInstance()->GetSurfaceFactoryOzone();
-  if (HasEquivalentBufferFormat(format) &&
+  // Imported decoder frames already have storage. Allocation support does not
+  // imply import support (or vice versa), notably for NV12 on Mesa/Panfrost.
+  // Keep the GL import capability check below and the actual import validation.
+  if (gmb_type != gfx::NATIVE_PIXMAP && HasEquivalentBufferFormat(format) &&
       !factory->CanCreateNativePixmapForFormat(ToBufferFormat(format))) {
     return false;
   }
